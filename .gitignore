# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.npm-cache
.celestrak-cache
*.pem
/certificates/

# local deploy helpers (not part of the app)
PUSH-TO-GITHUB.command
ADD-SSH-KEY-TO-GITHUB.txt
ORBITAL-VIEW-PROJECT-SUMMARY.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Space-Track scratch bake. The live catalog stays in public/data.
/scratch/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
